<?xml version="1.0" encoding="UTF-8"?>
<project xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns="http://maven.apache.org/POM/4.0.0"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>consulo</groupId>
        <artifactId>arch.bind.java</artifactId>
        <version>3-SNAPSHOT</version>
        <relativePath/>
    </parent>

    <groupId>consulo.plugin</groupId>
    <artifactId>consulo.perl5-core</artifactId>
    <version>3-SNAPSHOT</version>
    <packaging>jar</packaging>

    <repositories>
        <repository>
            <id>consulo</id>
            <url>https://maven.consulo.dev/repository/snapshots/</url>
            <snapshots>
                <enabled>true</enabled>
                <updatePolicy>interval:60</updatePolicy>
            </snapshots>
        </repository>
    </repositories>

    <properties>
        <upstream.dir>${project.basedir}/../../plugin</upstream.dir>
    </properties>

    <build>
        <!-- aggregate of upstream projects plugin.common + plugin.backend + plugin.frontend (they share packages, so one JPMS module) -->
        <sourceDirectory>${upstream.dir}/common/src/main/java</sourceDirectory>

        <plugins>
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>build-helper-maven-plugin</artifactId>
                <version>3.6.0</version>
                <executions>
                    <execution>
                        <id>upstream-sources</id>
                        <!-- initialize: must run before generate-lexers scans compile source roots for *.flex -->
                        <phase>initialize</phase>
                        <goals>
                            <goal>add-source</goal>
                        </goals>
                        <configuration>
                            <sources>
                                <!-- Consulo-only sources (registrations etc. that upstream does in xml) -->
                                <source>${project.basedir}/src/main/java</source>
                                <source>${upstream.dir}/backend/src/main/java</source>
                                <source>${upstream.dir}/frontend/src/main/java</source>
                                <!-- other upstream projects of the com.perl5 plugin (docker, wsl, terminal, idea: not ported yet) -->
                                <source>${upstream.dir}/carton/src/main/java</source>
                                <source>${upstream.dir}/cpan/src/main/java</source>
                                <source>${upstream.dir}/cpanminus/common/src/main/java</source>
                                <source>${upstream.dir}/cpanminus/backend/src/main/java</source>
                                <source>${upstream.dir}/perlbrew/src/main/java</source>
                                <source>${upstream.dir}/plenv/src/main/java</source>
                                <source>${upstream.dir}/asdf/src/main/java</source>
                                <source>${upstream.dir}/berrybrew/src/main/java</source>
                                <source>${upstream.dir}/perlInstall/src/main/java</source>
                                <source>${upstream.dir}/makeMaker/src/main/java</source>
                                <source>${upstream.dir}/moduleBuild/src/main/java</source>
                                <source>${upstream.dir}/structureView/src/main/java</source>
                                <source>${upstream.dir}/debugger/src/main/java</source>
                                <source>${upstream.dir}/profiler/src/main/java</source>
                                <source>${upstream.dir}/coverage/src/main/java</source>
                                <source>${upstream.dir}/copyright/src/main/java</source>
                                <source>${upstream.dir}/intelliLang/src/main/java</source>
                                <source>${upstream.dir}/common/grammar</source>
                            </sources>
                        </configuration>
                    </execution>
                    <execution>
                        <id>upstream-resources</id>
                        <phase>initialize</phase>
                        <goals>
                            <goal>add-resource</goal>
                        </goals>
                        <configuration>
                            <resources>
                                <resource>
                                    <directory>${upstream.dir}/common/src/main/resources</directory>
                                    <!-- IntelliJ service registrations (JPS etc.) -->
                                    <excludes>
                                        <exclude>META-INF/services/**</exclude>
                                    </excludes>
                                </resource>
                                <resource>
                                    <directory>${upstream.dir}/backend/src/main/resources</directory>
                                    <!-- IntelliJ service registrations (JPS etc.) -->
                                    <excludes>
                                        <exclude>META-INF/services/**</exclude>
                                    </excludes>
                                </resource>
                                <resource>
                                    <directory>${upstream.dir}/frontend/src/main/resources</directory>
                                    <!-- IntelliJ service registrations (JPS etc.) -->
                                    <excludes>
                                        <exclude>META-INF/services/**</exclude>
                                    </excludes>
                                </resource>
                                <resource>
                                    <directory>${upstream.dir}/carton/src/main/resources</directory>
                                    <excludes>
                                        <exclude>META-INF/**</exclude>
                                    </excludes>
                                </resource>
                                <resource>
                                    <directory>${upstream.dir}/cpan/src/main/resources</directory>
                                    <excludes>
                                        <exclude>META-INF/**</exclude>
                                    </excludes>
                                </resource>
                                <resource>
                                    <directory>${upstream.dir}/cpanminus/common/src/main/resources</directory>
                                    <excludes>
                                        <exclude>META-INF/**</exclude>
                                    </excludes>
                                </resource>
                                <resource>
                                    <directory>${upstream.dir}/cpanminus/backend/src/main/resources</directory>
                                    <excludes>
                                        <exclude>META-INF/**</exclude>
                                    </excludes>
                                </resource>
                                <resource>
                                    <directory>${upstream.dir}/perlbrew/src/main/resources</directory>
                                    <excludes>
                                        <exclude>META-INF/**</exclude>
                                    </excludes>
                                </resource>
                                <resource>
                                    <directory>${upstream.dir}/plenv/src/main/resources</directory>
                                    <excludes>
                                        <exclude>META-INF/**</exclude>
                                    </excludes>
                                </resource>
                                <resource>
                                    <directory>${upstream.dir}/asdf/src/main/resources</directory>
                                    <excludes>
                                        <exclude>META-INF/**</exclude>
                                    </excludes>
                                </resource>
                                <resource>
                                    <directory>${upstream.dir}/berrybrew/src/main/resources</directory>
                                    <excludes>
                                        <exclude>META-INF/**</exclude>
                                    </excludes>
                                </resource>
                                <resource>
                                    <directory>${upstream.dir}/perlInstall/src/main/resources</directory>
                                    <excludes>
                                        <exclude>META-INF/**</exclude>
                                    </excludes>
                                </resource>
                                <resource>
                                    <directory>${upstream.dir}/makeMaker/src/main/resources</directory>
                                    <excludes>
                                        <exclude>META-INF/**</exclude>
                                    </excludes>
                                </resource>
                                <resource>
                                    <directory>${upstream.dir}/moduleBuild/src/main/resources</directory>
                                    <excludes>
                                        <exclude>META-INF/**</exclude>
                                    </excludes>
                                </resource>
                                <resource>
                                    <directory>${upstream.dir}/structureView/src/main/resources</directory>
                                    <excludes>
                                        <exclude>META-INF/**</exclude>
                                    </excludes>
                                </resource>
                                <resource>
                                    <directory>${upstream.dir}/debugger/src/main/resources</directory>
                                    <excludes>
                                        <exclude>META-INF/**</exclude>
                                    </excludes>
                                </resource>
                                <resource>
                                    <directory>${upstream.dir}/profiler/src/main/resources</directory>
                                    <excludes>
                                        <exclude>META-INF/**</exclude>
                                    </excludes>
                                </resource>
                                <resource>
                                    <directory>${upstream.dir}/coverage/src/main/resources</directory>
                                    <excludes>
                                        <exclude>META-INF/**</exclude>
                                    </excludes>
                                </resource>
                                <resource>
                                    <directory>${upstream.dir}/copyright/src/main/resources</directory>
                                    <excludes>
                                        <exclude>META-INF/**</exclude>
                                    </excludes>
                                </resource>
                                <resource>
                                    <directory>${upstream.dir}/intelliLang/src/main/resources</directory>
                                    <excludes>
                                        <exclude>META-INF/**</exclude>
                                    </excludes>
                                </resource>
                            </resources>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <!-- TODO consulo: replace with a real module-info.java; until then the jar is an automatic module -->
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-jar-plugin</artifactId>
                <configuration>
                    <archive>
                        <manifestEntries>
                            <Automatic-Module-Name>consulo.perl5.core</Automatic-Module-Name>
                        </manifestEntries>
                    </archive>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <configuration>
                    <compilerArgs combine.children="append">
                        <arg>-Xmaxerrs</arg>
                        <arg>100000</arg>
                    </compilerArgs>
                    <!-- upstream files with no Consulo counterpart; kept in the tree (untouched) for merges -->
                    <excludes>
                        <!-- IntelliJ split mode (remote development) settings sync -->
                        <exclude>**/*RemoteInfoProvider.java</exclude>
                        <!-- JPS model serialization, Consulo has no JPS -->
                        <exclude>com/perl5/lang/perl/idea/modules/PerlSourceTypesSerializationExtension.java</exclude>
                        <!-- Kotlin UI DSL page, to be rewritten with uni UI -->
                        <exclude>com/perl5/lang/perl/idea/editor/smartkeys/options/PerlSmartKeyOptions.java</exclude>
                        <!-- test-only parser diagnostics subclassing IntelliJ's PsiBuilderImpl internals (StartMarker is private in Consulo) -->
                        <exclude>com/intellij/lang/impl/PerlDebugBuilder.java</exclude>
                        <exclude>com/intellij/lang/impl/PerlStartMarker.java</exclude>
                        <!-- YouTrack error reporter: Consulo has no plugin error report submitter extension point -->
                        <exclude>com/perl5/errorHandler/**</exclude>
                        
                    </excludes>
                </configuration>
            </plugin>
            <plugin>
                <groupId>consulo.maven</groupId>
                <artifactId>maven-consulo-plugin</artifactId>
                <extensions>true</extensions>
                <executions>
                    <execution>
                        <id>icons</id>
                        <!-- validate: before build-helper adds upstream resource dirs; generate-icon stops at the first resource dir without ICON-LIB -->
                        <phase>validate</phase>
                        <goals>
                            <goal>generate-icon</goal>
                        </goals>
                    </execution>
                    <execution>
                        <id>gen</id>
                        <phase>generate-sources</phase>
                        <goals>
                            <goal>generate-lexers</goal>
                            <goal>generate-parsers</goal>
                        </goals>
                        <configuration>
                            <externalGrammars>
                                <externalGrammar>${upstream.dir}/common/grammar/Perl5.bnf</externalGrammar>
                                <externalGrammar>${upstream.dir}/common/grammar/Pod.bnf</externalGrammar>
                            </externalGrammars>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>

    <dependencies>

        <!-- platform -->
        <dependency>
            <groupId>consulo</groupId>
            <artifactId>consulo-ide-api</artifactId>
            <version>${project.version}</version>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>consulo</groupId>
            <artifactId>consulo-language-impl</artifactId>
            <version>${project.version}</version>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>consulo</groupId>
            <artifactId>consulo-language-editor-impl</artifactId>
            <version>${project.version}</version>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>consulo</groupId>
            <artifactId>consulo-execution-api</artifactId>
            <version>${project.version}</version>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>consulo</groupId>
            <artifactId>consulo-execution-impl</artifactId>
            <version>${project.version}</version>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>consulo</groupId>
            <artifactId>consulo-execution-debug-api</artifactId>
            <version>${project.version}</version>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>consulo</groupId>
            <artifactId>consulo-execution-test-api</artifactId>
            <version>${project.version}</version>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>consulo</groupId>
            <artifactId>consulo-execution-test-sm-api</artifactId>
            <version>${project.version}</version>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>consulo</groupId>
            <artifactId>consulo-process-api</artifactId>
            <version>${project.version}</version>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>consulo</groupId>
            <artifactId>consulo-language-spellchecker-api</artifactId>
            <version>${project.version}</version>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>consulo</groupId>
            <artifactId>consulo-execution-coverage-api</artifactId>
            <version>${project.version}</version>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>consulo</groupId>
            <artifactId>consulo-execution-profiler-api</artifactId>
            <version>${project.version}</version>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>consulo</groupId>
            <artifactId>consulo-language-copyright-api</artifactId>
            <version>${project.version}</version>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>consulo</groupId>
            <artifactId>consulo-language-inject-advanced-api</artifactId>
            <version>${project.version}</version>
            <scope>provided</scope>
        </dependency>
        <!-- legacy: allowed only where the API is not opened elsewhere -->
        <dependency>
            <groupId>consulo</groupId>
            <artifactId>consulo-ide-impl</artifactId>
            <version>${project.version}</version>
            <scope>provided</scope>
        </dependency>

        <!-- plugins -->
        <dependency>
            <groupId>${project.groupId}</groupId>
            <artifactId>com.intellij.xml</artifactId>
            <version>${project.version}</version>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>${project.groupId}</groupId>
            <artifactId>com.intellij.regexp</artifactId>
            <version>${project.version}</version>
            <scope>provided</scope>
        </dependency>

        <!-- libraries -->
        <!-- upstream @NotNull/@Nullable are kept as is (compile-only) to keep diff with upstream small -->
        <dependency>
            <groupId>org.jetbrains</groupId>
            <artifactId>annotations</artifactId>
            <version>26.1.0</version>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>it.unimi.dsi</groupId>
            <artifactId>fastutil</artifactId>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>com.google.code.gson</groupId>
            <artifactId>gson</artifactId>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>com.google.guava</groupId>
            <artifactId>guava</artifactId>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>org.jdom</groupId>
            <artifactId>jdom-core</artifactId>
            <scope>provided</scope>
        </dependency>
    </dependencies>
</project>
