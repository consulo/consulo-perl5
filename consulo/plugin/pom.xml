<?xml version="1.0" encoding="UTF-8"?>
<project xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns="http://maven.apache.org/POM/4.0.0"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>consulo</groupId>
        <artifactId>arch.bind.java</artifactId>
        <version>3-SNAPSHOT</version>
        <relativePath/>
    </parent>

    <groupId>consulo.plugin</groupId>
    <artifactId>consulo.perl5</artifactId>
    <version>3-SNAPSHOT</version>
    <packaging>consulo-plugin</packaging>

    <repositories>
        <repository>
            <id>consulo</id>
            <url>https://maven.consulo.dev/repository/snapshots/</url>
            <snapshots>
                <enabled>true</enabled>
                <updatePolicy>interval:60</updatePolicy>
            </snapshots>
        </repository>
    </repositories>

    <!-- the com.perl5 plugin: packs consulo.perl5-core and runs the sandbox -->
    <build>
        <plugins>
            <plugin>
                <!-- TODO consulo: replace with a real module-info.java; until then the jar is an automatic module -->
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-jar-plugin</artifactId>
                <configuration>
                    <archive>
                        <manifestEntries>
                            <Automatic-Module-Name>consulo.perl5</Automatic-Module-Name>
                        </manifestEntries>
                    </archive>
                </configuration>
            </plugin>
            <plugin>
                <groupId>consulo.maven</groupId>
                <artifactId>maven-consulo-plugin</artifactId>
                <extensions>true</extensions>
                <configuration>
                    <dependencies>
                        <dependency>com.intellij.xml</dependency>
                        <dependency>com.intellij.regexp</dependency>
                    </dependencies>
                    <!-- sibling plugins of this repository, loaded into the same sandbox (-Prun-web / -Prun-desktop) -->
                    <execution>
                        <pluginDirectories>
                            <pluginDirectory>${project.basedir}/../tt2/target/consulo-plugin-extracted</pluginDirectory>
                            <pluginDirectory>${project.basedir}/../mojo/target/consulo-plugin-extracted</pluginDirectory>
                            <pluginDirectory>${project.basedir}/../embedded/target/consulo-plugin-extracted</pluginDirectory>
                            <pluginDirectory>${project.basedir}/../mason/target/consulo-plugin-extracted</pluginDirectory>
                        </pluginDirectories>
                    </execution>
                    <packaging>
                        <skip>${dev.mode}</skip>
                        <version>${build.number}</version>
                    </packaging>
                </configuration>
                <executions>
                    <execution>
                        <phase>package</phase>
                        <goals>
                            <goal>workspace</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>

    <!-- run Consulo with this plugin in consulo/plugin/sandbox: mvn package -Prun-web (http://localhost:8080) or -Prun-desktop -->
    <profiles>
        <profile>
            <id>run-web</id>
            <build>
                <plugins>
                    <plugin>
                        <groupId>consulo.maven</groupId>
                        <artifactId>maven-consulo-plugin</artifactId>
                        <executions>
                            <execution>
                                <id>run-web</id>
                                <phase>package</phase>
                                <goals>
                                    <goal>run-web-fork</goal>
                                </goals>
                            </execution>
                        </executions>
                    </plugin>
                </plugins>
            </build>
        </profile>
        <profile>
            <id>run-desktop</id>
            <build>
                <plugins>
                    <plugin>
                        <groupId>consulo.maven</groupId>
                        <artifactId>maven-consulo-plugin</artifactId>
                        <executions>
                            <execution>
                                <id>run-desktop</id>
                                <phase>package</phase>
                                <goals>
                                    <goal>run-desktop-awt-fork</goal>
                                </goals>
                            </execution>
                        </executions>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>

    <dependencies>
        <dependency>
            <groupId>${project.groupId}</groupId>
            <artifactId>consulo.perl5-core</artifactId>
            <version>${project.version}</version>
        </dependency>

        <!-- build order only: the sandbox run (-Prun-web / -Prun-desktop) loads the sibling plugins from their target dirs -->
        <dependency>
            <groupId>${project.groupId}</groupId>
            <artifactId>consulo.perl5-tt2</artifactId>
            <version>${project.version}</version>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>${project.groupId}</groupId>
            <artifactId>consulo.perl5-mojo</artifactId>
            <version>${project.version}</version>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>${project.groupId}</groupId>
            <artifactId>consulo.perl5-embedded</artifactId>
            <version>${project.version}</version>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>${project.groupId}</groupId>
            <artifactId>consulo.perl5-mason</artifactId>
            <version>${project.version}</version>
            <scope>provided</scope>
        </dependency>

        <!-- packaging reads the platform build number from it -->
        <dependency>
            <groupId>consulo</groupId>
            <artifactId>consulo-application-api</artifactId>
            <version>${project.version}</version>
            <scope>provided</scope>
        </dependency>
    </dependencies>
</project>
